DATABASE_URL="postgresql://tasko:tasko@localhost:5434/tasko?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="7d"
FRONTEND_URL="http://localhost:5173"
PORT=3000

# Почта (SMTP). Если SMTP_HOST пуст, письма выводятся в лог бэкенда.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TASKO <no-reply@example.com>"

# За сколько часов до срока напоминать исполнителю (проверка раз в час)
DEADLINE_REMINDER_HOURS=24

# Сервис прогноза (папка ml/). Пусто — прогноз по простым правилам, без ML
ML_SERVICE_URL="http://localhost:8001"
# Сколько ждать ответа сервиса, мс. Если не успел — задача сохраняется без нового прогноза
ML_TIMEOUT_MS=3000
