{
  "name": "tasko-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.8.4",
    "dayjs": "^1.11.13",
    "element-plus": "^2.9.7",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.32.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "sass": "^1.86.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.46.0",
    "vite": "^6.2.4",
    "vitest": "3.0.9",
    "vue-tsc": "^2.2.8"
  }
}
